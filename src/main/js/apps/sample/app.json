{
    "properties": {
        "title": "${apptitle}"
    },
    "load": {
        "bundleLocations": [
            "localbundles",
            "bundles"
        ],
        "allowedBundles": [
            "agssearch",
            "banner",
            "console",
            "dn_selection-resultcenter",
            "dn_resultcenter",
            "map-init",
            "languagetoggler",
            "system",
            "toolset",
            "templatelayout",
            "template-seasons",
            "theme-autumn",
            "custominfo"
        ],
        "i18n": [
            "bundle"
        ]
    },
    "bundles": {
        "banner": {
            "BannerWidget": {
                "label": "Developer Network",
                "image": "resource('${app}:/assets/logo.svg')",
                "imageWidth": 150,
                "imagePosition": "above",
                "link": "http://conterra.github.io"
            }
        },
        "custominfo": {
            "CustomInfoToggleTool": [
                {
                    "id": "sampleDescriptionTool",
                    "title": "Sample Description",
                    "widgetSettings": {
                        "content": "${custominfoContent}",
                        "window": {
                            "marginBox": {
                                "w": 250,
                                "h": 250,
                                "t": 100,
                                "l": 150
                            }
                        }
                    },
                    "rules": {
                        "groups": "custominfo",
                        "activateOnStartup": true
                    }
                }
            ]
        },
        "agssearch": {
            "AGSStore": [
                {
                    "id": "countries",
                    "url": "https://services.conterra.de/arcgis/rest/services/common/grenzen/MapServer/3",
                    "title": "${map.countries}",
                    "fetchIdProperty": true
                },
                {
                    "id": "stoerungen_store",
                    "url": "https://services.conterra.de/arcgis/rest/services/mapapps/stoerung/FeatureServer/0",
                    "title": "${map.incidents}",
                    "fetchIdProperty": true
                }
            ]
        },
        "resultcenter": {
            "SearchStoreTool": [
                {
                    "id": "search_stoerungen",
                    "title": "${tools.incidents}",
                    "storeId": "stoerungen_store",
                    "iconClass": "icon-sign-warning"
                },
                {
                    "id": "search_countries",
                    "title": "${tools.countries}",
                    "storeId": "countries",
                    "iconClass": "icon-globe-flat"
                }
            ]
        },
        "map-init": {
            "Config": {
                "map": {
                    "basemap": "streets-vector",
                    "layers": [
                        {
                            "id": "stoerungen",
                            "type": "AGS_FEATURE",
                            "url": "https://services.conterra.de/arcgis/rest/services/mapapps/stoerung/FeatureServer/0",
                            "title": "${map.incidents}"
                        }
                    ]
                },
                "view": {
                    "viewmode": "2D",
                    "extent": {
                        "xmin": 619578.155777645,
                        "ymin": 5965284.64146539,
                        "xmax": 1733575.1859872,
                        "ymax": 7373509.3231059,
                        "spatialReference": 3857
                    }
                }
            }
        }
    }
}
