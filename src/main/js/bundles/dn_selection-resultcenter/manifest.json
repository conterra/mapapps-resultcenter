{
    "name": "dn_selection-resultcenter",
    "version": "4.19.3-SNAPSHOT",
    "title": "Selection Resultcenter Integration",
    "description": "This bundles provides an extension to the user interface of the resultcenter. It adds the ability to display and interact with the results of multiple selections.",
    "vendor": "con terra GmbH",
    "productName": "devnet-mapapps-resultcenter",
    "deprecated": {
        "message": "This bundle is deprecated. Use the bundle 'result-ui' instead.",
        "since": "4.14"
    },
    "bundle": true,
    "main": "",
    "layer": "module",
    "i18n": ["bundle"],
    "keywords": ["mapping", "selection", "resultcenter"],
    "dependencies": {
        "esri": "~4.31.6",
        "apprt-core": "~4.19.3-SNAPSHOT",
        "apprt-vue": "~4.19.3-SNAPSHOT",
        "apprt-vuetify": "~4.19.3-SNAPSHOT",
        "apprt-streams": "~4.19.3-SNAPSHOT",
        "apprt-binding": "~4.19.3-SNAPSHOT",
        "ct": "~4.19.3-SNAPSHOT",
        "resultcenter": "~4.19.3-SNAPSHOT",
        "selection-services": "~4.19.3-SNAPSHOT",
        "store-api": "~4.19.3-SNAPSHOT",
        "dojo": "~1.17.3"
    },
    "components": [
        {
            "name": "ExecutionsModel",
            "provides": "selection-resultcenter.ExecutionsModel",
            "references": [
                {
                    "name": "dataModel",
                    "providing": "resultcenter.DataModel"
                }
            ]
        },
        {
            "name": "Config",
            "impl": "./ExecutionsController",
            "properties": {
                "showFilterButton": true,
                "filterByDefault": true
            },
            "references": [
                {
                    "name": "executionsModel",
                    "providing": "selection-resultcenter.ExecutionsModel"
                },
                {
                    "name": "dataModel",
                    "providing": "resultcenter.DataModel"
                },
                {
                    "name": "resultcenterToggleTool",
                    "providing": "ct.tools.Tool",
                    "filter": "(id=resultcenterToggleTool)"
                },
                {
                    "name": "_storeFactory",
                    "providing": "resultcenter.StoreFactory"
                }
            ]
        },
        {
            "name": "ExecutionsToolRuleProcessor",
            "provides": "toolrules.ToolRuleProcessor",
            "references": [
                {
                    "name": "_model",
                    "providing": "selection-resultcenter.ExecutionsModel"
                },
                {
                    "name": "_ruleContextState",
                    "providing": "toolrules.ToolRuleContext"
                }
            ]
        },
        {
            "name": "SelectionEventReceiver",
            "provides": "ct.framework.api.EventHandler",
            "properties": {
                "Event-Topics": [
                    {
                        "topic": "selection/EXECUTING",
                        "method": "receive"
                    }
                ]
            },
            "references": [
                {
                    "name": "executionsModel",
                    "providing": "selection-resultcenter.ExecutionsModel"
                },
                {
                    "name": "tool",
                    "providing": "ct.tools.Tool",
                    "filter": "(id=resultcenterToggleTool)"
                }
            ]
        },
        {
            "name": "StoreFactory",
            "provides": "resultcenter.StoreFactory"
        }
    ]
}
